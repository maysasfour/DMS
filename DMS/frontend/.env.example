# Frontend Environment Variables
# Copy to .env.local for local development (never commit .env.local)

# Google OAuth2 Client ID
# Get from: https://console.cloud.google.com → APIs & Services → Credentials
# Leave empty to hide Google login button
VITE_GOOGLE_CLIENT_ID=

# API base URL override (optional — defaults to Vite proxy in dev)
# VITE_API_BASE_URL=https://dms-backend.yourdomain.com/api/v1

# Gemini credentials belong only in the server-side DMS/.env file.
