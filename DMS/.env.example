# Copy to .env. Supply private values; never commit the resulting file.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dms_db
DB_USERNAME=postgres
DB_PASSWORD=
JWT_SECRET=
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=2592000000
PGADMIN_PASSWORD=
FRONTEND_ORIGIN=http://localhost:3000
SERVER_PORT=9090
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
GEMINI_API_KEY=
MAIL_USERNAME=
MAIL_PASSWORD=
# Optional BCrypt hashes for fresh database seeds. Empty values disable login.
# Single-quote hash values in private .env files so Docker preserves dollar signs.
SEED_ADMIN_HASH=
SEED_CITIZEN_HASH=
SEED_LEGACY_ADMIN_HASH=
SEED_LEGACY_CITIZEN_HASH=
SEED_PERSONAL_ADMIN_HASH=
SEED_PERSONAL_ADMIN_EMAIL=disabled@example.invalid
